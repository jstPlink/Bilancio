# Copia questo file in ".env" (resta sul tuo computer, non finisce su GitHub).

# Password di accesso (web, app e widget). Obbligatoria se il server non gira solo su 127.0.0.1.
# MYBANK_PASSWORD=scegli-una-password-lunga

# Indirizzo del tuo server MyBank. Con questa riga `npm start` è un localhost senza dati suoi (pagine di questa cartella, dati e login dal server);
# lo stesso indirizzo finisce nell'APK (npm run apk) invece di essere chiesto alla prima apertura.
# MYBANK_SERVER=https://mybank.miodominio.it

# Facoltativi: indirizzo pubblico per il ritorno dalla banca, ore degli aggiornamenti automatici, cartella dei dati.
# MYBANK_PUBLIC_URL=https://mybank.miodominio.it
# MYBANK_AUTO_HOURS=5,11,14,19
# MYBANK_DATA=./data

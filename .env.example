# Facoltativo: fissa la password di accesso invece di crearla dalla pagina di accesso.
# Copia questo file in ".env" (resta sul tuo computer, non finisce su GitHub) e togli il # dalla riga qui sotto.
# BILANCIO_PASSWORD=scegli-una-password-lunga

# Fa puntare il localhost a un server Bilancio: dati e password sono quelli del server, niente database locale.
# BILANCIO_SERVER=https://indirizzo-del-tuo-server

{
  "name": "mybank",
  "version": "0.21.1",
  "description": "MyBank: i movimenti di UniCredit e Revolut, il budget e il widget, dal web e da Android.",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "start": "node --env-file-if-exists=.env src/local.js",
    "server": "node --env-file-if-exists=.env src/start.js",
    "dev": "node --watch --env-file-if-exists=.env src/local.js",
    "test": "node --test \"test/**/*.test.js\"",
    "demo": "node scripts/demo.mjs",
    "apk": "node scripts/build-apk.mjs",
    "apk:installa": "node scripts/build-apk.mjs --install"
  },
  "license": "UNLICENSED",
  "private": true,
  "dependencies": {
    "express": "^5.2.1"
  }
}

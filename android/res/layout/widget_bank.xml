<?xml version="1.0" encoding="utf-8"?>
<!-- Widget «Saldo» (3×1): saldo Revolut e ultimo movimento dall'ultima lettura (non in tempo reale). Stesso stile di «Questo mese 2»:
     teal dell'app, riquadri bianchi trasparenti, etichette da 12 sp e cifre da 16,5 sp in grassetto; nessun altro colore. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_bank_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingLeft="8dp"
    android:paddingRight="8dp"
    android:paddingTop="8dp"
    android:paddingBottom="8dp"
    android:background="@drawable/widget_bg">

    <!-- Saldo, con da quando sono i dati -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center"
        android:paddingLeft="4dp"
        android:paddingRight="4dp"
        android:background="@drawable/widget_cell">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Saldo Revolut"
            android:textColor="#E6FFFFFF"
            android:textSize="12sp"
            android:includeFontPadding="false"
            android:singleLine="true" />
        <TextView
            android:id="@+id/widget_bank_balance"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#FFFFFF"
            android:textSize="16.5sp"
            android:textStyle="bold"
            android:includeFontPadding="false"
            android:ellipsize="end"
            android:singleLine="true" />
        <TextView
            android:id="@+id/widget_bank_since"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#E6FFFFFF"
            android:textSize="12sp"
            android:includeFontPadding="false"
            android:singleLine="true" />
    </LinearLayout>

    <!-- Ultimo movimento: importo e nome -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center"
        android:layout_marginLeft="6dp"
        android:paddingLeft="4dp"
        android:paddingRight="4dp"
        android:background="@drawable/widget_cell">
        <TextView
            android:id="@+id/widget_bank_last_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Ultimo"
            android:textColor="#E6FFFFFF"
            android:textSize="12sp"
            android:includeFontPadding="false"
            android:singleLine="true" />
        <TextView
            android:id="@+id/widget_bank_last"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#FFFFFF"
            android:textSize="16.5sp"
            android:textStyle="bold"
            android:includeFontPadding="false"
            android:ellipsize="end"
            android:singleLine="true" />
        <TextView
            android:id="@+id/widget_bank_last_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#E6FFFFFF"
            android:textSize="12sp"
            android:includeFontPadding="false"
            android:ellipsize="end"
            android:singleLine="true" />
    </LinearLayout>
</LinearLayout>

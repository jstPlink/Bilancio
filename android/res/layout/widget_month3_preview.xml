<?xml version="1.0" encoding="utf-8"?>
<!-- Anteprima statica (dati di esempio) per la lista dei widget. File generato da scripts/genera-widget.mjs -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingLeft="8dp"
    android:paddingRight="8dp"
    android:paddingTop="4dp"
    android:paddingBottom="4dp"
    android:background="@drawable/widget_bg">

    <!-- Solo «Da pagare» (qui non c'è «dal 1° OTT») -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:layout_marginRight="2dp"
        android:orientation="vertical">

        <!-- Da pagare: rosso se resta qualcosa, verde chiaro se è tutto pagato -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center"
            android:paddingLeft="4dp"
            android:paddingRight="4dp"
            android:background="@drawable/widget_cell_due">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Da pagare (3)"
                android:textColor="#E6FFFFFF"
                android:textSize="12.5sp"
                android:singleLine="true" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="245,00 €"
                android:textColor="#FFFFFF"
                android:textSize="17.5sp"
                android:textStyle="bold"
                android:singleLine="true" />
        </LinearLayout>
    </LinearLayout>


    <!-- Spese resta: contenitore con il residuo del budget, che scende dall'alto; la superficie è un'onda sinusoidale che scorre verso destra (fotogrammi in un ViewFlipper) -->
    <FrameLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:layout_marginLeft="2dp"
        android:layout_marginRight="2dp"
        android:background="@drawable/widget_cell"
        android:clipToOutline="true">
        <ImageView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@drawable/preview_fill_a"
            android:scaleType="fitXY" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center"
            android:paddingLeft="2dp"
            android:paddingRight="2dp">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Spese resta"
                android:textColor="#E6FFFFFF"
                android:textSize="12.5sp"
                android:singleLine="true" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="187,60 €"
                android:textColor="#FFFFFF"
                android:textSize="16.5sp"
                android:textStyle="bold"
                android:singleLine="true" />
            <!-- stima e reale in un solo sfondo tondo, una riga sotto l'altra -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:orientation="vertical"
                android:gravity="center_horizontal"
                android:paddingLeft="6dp"
                android:paddingRight="6dp"
                android:paddingTop="1dp"
                android:paddingBottom="1dp"
                android:background="@drawable/widget_pill">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="stima €13,30"
                android:textColor="#FFFFFFFF"
                android:textSize="10.5sp"
                android:textStyle="bold"
                android:singleLine="true" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="reale €15,10"
                android:textColor="#FF4ADE80"
                android:textSize="10.5sp"
                android:textStyle="bold"
                android:singleLine="true" />
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>


<?xml version="1.0" encoding="utf-8"?>
<!-- Widget MyBank 5x1: a sinistra la barra del mese (tacche sulle domeniche, giorni che restano) e l'ultimo aggiornamento delle banche;
     poi Spesa, Svago e Carburante: residuo del budget, spesa giornaliera stimata e reale. Anteprima statica per la lista dei widget. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingLeft="6dp"
    android:paddingRight="6dp"
    android:background="@drawable/widget_bg">
    <LinearLayout
        android:id="@+id/widget_month_cell"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1.45"
        android:orientation="vertical"
        android:gravity="center"
        android:paddingLeft="6dp"
        android:paddingRight="6dp">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">
            <ImageView
                android:layout_width="0dp"
                android:layout_height="12dp"
                android:layout_weight="1"
                android:src="@drawable/preview_bar"
                android:scaleType="fitXY" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="19 gg"
                android:layout_marginLeft="6dp"
                android:textColor="#F3F0EA"
                android:textSize="11sp"
                android:fontFamily="monospace"
                android:textStyle="bold"
                android:singleLine="true" />
        </LinearLayout>
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="AGG. 14:02"
            android:layout_marginTop="5dp"
            android:textColor="#A8A298"
            android:textSize="10sp"
            android:fontFamily="monospace"
            android:singleLine="true" />
    </LinearLayout>
    <View
        android:layout_width="1dp"
        android:layout_height="match_parent"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="6dp"
        android:background="#3A3733" />
    <LinearLayout
        android:id="@+id/widget_spesa_cell"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center"
        android:paddingLeft="4dp"
        android:paddingRight="4dp">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="SPESA"
            android:textColor="#A8A298"
            android:textSize="9.5sp"
            android:fontFamily="monospace"
            android:singleLine="true" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="187,60 €"
            android:textColor="#F3F0EA"
            android:textSize="17sp"
            android:fontFamily="serif"
            android:textStyle="bold"
            android:singleLine="true" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="stima 13,3/g"
            android:textColor="#A8A298"
            android:textSize="10sp"
            android:fontFamily="monospace"
            android:singleLine="true" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="reale 9,4/g"
            android:textColor="#5CCB8A"
            android:textSize="10sp"
            android:fontFamily="monospace"
            android:singleLine="true" />
    </LinearLayout>
    <View
        android:layout_width="1dp"
        android:layout_height="match_parent"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="6dp"
        android:background="#3A3733" />
    <LinearLayout
        android:id="@+id/widget_svago_cell"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center"
        android:paddingLeft="4dp"
        android:paddingRight="4dp">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="SVAGO"
            android:textColor="#A8A298"
            android:textSize="9.5sp"
            android:fontFamily="monospace"
            android:singleLine="true" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="58,80 €"
            android:textColor="#F3F0EA"
            android:textSize="17sp"
            android:fontFamily="serif"
            android:textStyle="bold"
            android:singleLine="true" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="stima 3,9/g"
            android:textColor="#A8A298"
            android:textSize="10sp"
            android:fontFamily="monospace"
            android:singleLine="true" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="reale 5,1/g"
            android:textColor="#FF5A2E"
            android:textSize="10sp"
            android:fontFamily="monospace"
            android:singleLine="true" />
    </LinearLayout>
    <View
        android:layout_width="1dp"
        android:layout_height="match_parent"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="6dp"
        android:background="#3A3733" />
    <LinearLayout
        android:id="@+id/widget_carburante_cell"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center"
        android:paddingLeft="4dp"
        android:paddingRight="4dp">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="CARBURANTE"
            android:textColor="#A8A298"
            android:textSize="9.5sp"
            android:fontFamily="monospace"
            android:singleLine="true" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="14,00 €"
            android:textColor="#F3F0EA"
            android:textSize="17sp"
            android:fontFamily="serif"
            android:textStyle="bold"
            android:singleLine="true" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="stima 3,2/g"
            android:textColor="#A8A298"
            android:textSize="10sp"
            android:fontFamily="monospace"
            android:singleLine="true" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="reale 6,5/g"
            android:textColor="#FF5A2E"
            android:textSize="10sp"
            android:fontFamily="monospace"
            android:singleLine="true" />
    </LinearLayout>
</LinearLayout>

        <ViewFlipper
            android:id="@+id/widget_month_svago_fill"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:autoStart="true"
            android:flipInterval="285">
            <ImageView android:id="@+id/fl_svago_0" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitXY" />
            <ImageView android:id="@+id/fl_svago_1" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitXY" />
            <ImageView android:id="@+id/fl_svago_2" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitXY" />
            <ImageView android:id="@+id/fl_svago_3" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitXY" />
            <ImageView android:id="@+id/fl_svago_4" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitXY" />
            <ImageView android:id="@+id/fl_svago_5" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitXY" />
            <ImageView android:id="@+id/fl_svago_6" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitXY" />
            <ImageView android:id="@+id/fl_svago_7" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitXY" />
            <ImageView android:id="@+id/fl_svago_8" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitXY" />
            <ImageView android:id="@+id/fl_svago_9" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitXY" />
            <ImageView android:id="@+id/fl_svago_10" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitXY" />
            <ImageView android:id="@+id/fl_svago_11" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitXY" />
            <ImageView android:id="@+id/fl_svago_12" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitXY" />
            <ImageView android:id="@+id/fl_svago_13" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitXY" />
            <ImageView android:id="@+id/fl_svago_14" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitXY" />
            <ImageView android:id="@+id/fl_svago_15" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitXY" />
        </ViewFlipper>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center"
            android:paddingLeft="2dp"
            android:paddingRight="2dp">
            <TextView
                android:id="@+id/widget_month_svago_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Svago resta"
                android:textColor="#E6FFFFFF"
                android:textSize="12.5sp"
                android:singleLine="true" />
            <TextView
                android:id="@+id/widget_month_svago"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#FFFFFF"
                android:textSize="16.5sp"
                android:textStyle="bold"
                android:singleLine="true" />
            <!-- stima e reale in un solo sfondo tondo, una riga sotto l'altra -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:orientation="vertical"
                android:gravity="center_horizontal"
                android:paddingLeft="6dp"
                android:paddingRight="6dp"
                android:paddingTop="1dp"
                android:paddingBottom="1dp"
                android:background="@drawable/widget_pill">
            <TextView
                android:id="@+id/widget_month_svago_est"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#FFFFFFFF"
                android:textSize="10.5sp"
                android:textStyle="bold"
                android:singleLine="true" />
            <TextView
                android:id="@+id/widget_month_svago_act"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#FFFFFFFF"
                android:textSize="10.5sp"
                android:textStyle="bold"
                android:singleLine="true" />
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>

    <!-- Carburante resta: contenitore con il residuo del budget, che scende dall'alto; la superficie è un'onda sinusoidale che scorre verso destra (fotogrammi in un ViewFlipper) -->
    <FrameLayout
        android:id="@+id/widget_month_carburante_cell"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:layout_marginLeft="2dp"
        android:layout_marginRight="2dp"
        android:background="@drawable/widget_cell"
        android:clipToOutline="true">
        <ViewFlipper
            android:id="@+id/widget_month_carburante_fill"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:autoStart="true"
            android:flipInterval="285">
            <ImageView android:id="@+id/fl_carburante_0" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitXY" />
            <ImageView android:id="@+id/fl_carburante_1" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitXY" />
            <ImageView android:id="@+id/fl_carburante_2" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitXY" />
            <ImageView android:id="@+id/fl_carburante_3" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitXY" />
            <ImageView android:id="@+id/fl_carburante_4" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitXY" />
            <ImageView android:id="@+id/fl_carburante_5" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitXY" />
            <ImageView android:id="@+id/fl_carburante_6" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitXY" />
            <ImageView android:id="@+id/fl_carburante_7" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitXY" />
            <ImageView android:id="@+id/fl_carburante_8" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitXY" />
            <ImageView android:id="@+id/fl_carburante_9" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitXY" />
            <ImageView android:id="@+id/fl_carburante_10" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitXY" />
            <ImageView android:id="@+id/fl_carburante_11" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitXY" />
            <ImageView android:id="@+id/fl_carburante_12" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitXY" />
            <ImageView android:id="@+id/fl_carburante_13" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitXY" />
            <ImageView android:id="@+id/fl_carburante_14" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitXY" />
            <ImageView android:id="@+id/fl_carburante_15" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitXY" />
        </ViewFlipper>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center"
            android:paddingLeft="2dp"
            android:paddingRight="2dp">
            <TextView
                android:id="@+id/widget_month_carburante_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Carburante resta"
                android:textColor="#E6FFFFFF"
                android:textSize="12.5sp"
                android:singleLine="true" />
            <TextView
                android:id="@+id/widget_month_carburante"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#FFFFFF"
                android:textSize="16.5sp"
                android:textStyle="bold"
                android:singleLine="true" />
            <!-- stima e reale in un solo sfondo tondo, una riga sotto l'altra -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:orientation="vertical"
                android:gravity="center_horizontal"
                android:paddingLeft="6dp"
                android:paddingRight="6dp"
                android:paddingTop="1dp"
                android:paddingBottom="1dp"
                android:background="@drawable/widget_pill">
            <TextView
                android:id="@+id/widget_month_carburante_est"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#FFFFFFFF"
                android:textSize="10.5sp"
                android:textStyle="bold"
                android:singleLine="true" />
            <TextView
                android:id="@+id/widget_month_carburante_act"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#FFFFFFFF"
                android:textSize="10.5sp"

<?xml version="1.0" encoding="utf-8"?>
<!-- Widget MyBank 5x1, cinque celle di uguale larghezza (Mese, Spesa, Svago, Auto, Altro). In ogni categoria il livello del residuo riempie
     tutta la cella dal basso (immagine), con tacche al 25, 50 e 75%; nome e residuo stanno su una targhetta scura, stima e reale in due
     etichette piene. Il mese: giorni che restano e le settimane del calendario (weekend in rosso).
     Solo view ammesse nei RemoteViews (vedi test/android.test.js): un solo carattere, sans-serif. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:paddingLeft="8dp"
    android:paddingRight="8dp"
    android:paddingTop="6dp"
    android:paddingBottom="6dp"
    android:background="@drawable/widget_bg">
    <FrameLayout
        android:id="@+id/widget_month_cell"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:layout_margin="2.25dp">
        <ImageView
            android:id="@+id/widget_month_bg"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="fitXY" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="5dp">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="MESE"
                android:textColor="#A8A298"
                android:textSize="7.5sp"
                android:fontFamily="sans-serif"
                android:textStyle="bold"
                android:letterSpacing="0"
                android:singleLine="true" />
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="2dp">
                <TextView
                android:id="@+id/widget_days_num"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#F3F0EA"
                android:textSize="20sp"
                android:fontFamily="sans-serif"
                android:textStyle="bold"
                android:includeFontPadding="false"
                android:singleLine="true" />
                <TextView
                android:id="@+id/widget_days_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="2dp"
                android:textColor="#A8A298"
                android:textSize="9sp"
                android:fontFamily="sans-serif"
                android:includeFontPadding="false"
                android:maxLines="2" />
            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />
            <ImageView
                android:id="@+id/widget_weeks"
                android:layout_width="match_parent"
                android:layout_height="24dp"
                android:scaleType="fitXY" />
        </LinearLayout>
    </FrameLayout>
    <FrameLayout
        android:id="@+id/widget_spesa_cell"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:layout_margin="2.25dp">
        <ImageView
            android:id="@+id/widget_spesa_bg"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="fitXY" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="4dp">
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/widget_chip"
                android:paddingLeft="4dp"
                android:paddingRight="4dp"
                android:paddingTop="2dp"
                android:paddingBottom="2dp">
                <TextView
                android:id="@+id/widget_spesa_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="SPESA"
                android:textColor="#A8A298"
                android:textSize="7.5sp"
                android:fontFamily="sans-serif"
                android:textStyle="bold"
                android:letterSpacing="0"
                android:singleLine="true" />
                <TextView
                android:id="@+id/widget_spesa_left"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#F3F0EA"
                android:textSize="15sp"
                android:fontFamily="sans-serif"
                android:textStyle="bold"
                android:singleLine="true" />
            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />
            <TextView
                android:id="@+id/widget_spesa_est"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/widget_chip"
                android:paddingLeft="3dp"
                android:paddingRight="3dp"
                android:paddingTop="1dp"
                android:paddingBottom="1dp"
                android:layout_marginTop="2dp"
                android:textColor="#F3F0EA"
                android:textSize="9sp"
                android:fontFamily="sans-serif"
                android:singleLine="true" />
            <TextView
                android:id="@+id/widget_spesa_real"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/widget_chip"
                android:paddingLeft="3dp"
                android:paddingRight="3dp"
                android:paddingTop="1dp"
                android:paddingBottom="1dp"
                android:layout_marginTop="2dp"
                android:textColor="#F3F0EA"
                android:textSize="9sp"
                android:fontFamily="sans-serif"
                android:singleLine="true" />
        </LinearLayout>
    </FrameLayout>
    <FrameLayout
        android:id="@+id/widget_svago_cell"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:layout_margin="2.25dp">
        <ImageView
            android:id="@+id/widget_svago_bg"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="fitXY" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="4dp">
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/widget_chip"
                android:paddingLeft="4dp"
                android:paddingRight="4dp"
                android:paddingTop="2dp"
                android:paddingBottom="2dp">
                <TextView
                android:id="@+id/widget_svago_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="SVAGO"
                android:textColor="#A8A298"
                android:textSize="7.5sp"
                android:fontFamily="sans-serif"
                android:textStyle="bold"
                android:letterSpacing="0"
                android:singleLine="true" />
                <TextView
                android:id="@+id/widget_svago_left"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#FF5A2E"
                android:textSize="15sp"
                android:fontFamily="sans-serif"
                android:textStyle="bold"
                android:singleLine="true" />
            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />
            <TextView
                android:id="@+id/widget_svago_est"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/widget_chip"
                android:paddingLeft="3dp"
                android:paddingRight="3dp"
                android:paddingTop="1dp"
                android:paddingBottom="1dp"
                android:layout_marginTop="2dp"
                android:textColor="#F3F0EA"
                android:textSize="9sp"
                android:fontFamily="sans-serif"
                android:singleLine="true" />
            <TextView
                android:id="@+id/widget_svago_real"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/widget_chip"
                android:paddingLeft="3dp"
                android:paddingRight="3dp"
                android:paddingTop="1dp"
                android:paddingBottom="1dp"
                android:layout_marginTop="2dp"
                android:textColor="#FF5A2E"
                android:textSize="9sp"
                android:fontFamily="sans-serif"
                android:singleLine="true" />
        </LinearLayout>
    </FrameLayout>
    <FrameLayout
        android:id="@+id/widget_carburante_cell"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:layout_margin="2.25dp">
        <ImageView
            android:id="@+id/widget_carburante_bg"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="fitXY" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="4dp">
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/widget_chip"
                android:paddingLeft="4dp"
                android:paddingRight="4dp"
                android:paddingTop="2dp"
                android:paddingBottom="2dp">
                <TextView
                android:id="@+id/widget_carburante_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="AUTO"
                android:textColor="#A8A298"
                android:textSize="7.5sp"
                android:fontFamily="sans-serif"
                android:textStyle="bold"
                android:letterSpacing="0"
                android:singleLine="true" />
                <TextView
                android:id="@+id/widget_carburante_left"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#F3F0EA"
                android:textSize="15sp"
                android:fontFamily="sans-serif"
                android:textStyle="bold"
                android:singleLine="true" />
            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />
            <TextView
                android:id="@+id/widget_carburante_est"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/widget_chip"
                android:paddingLeft="3dp"
                android:paddingRight="3dp"
                android:paddingTop="1dp"
                android:paddingBottom="1dp"
                android:layout_marginTop="2dp"
                android:textColor="#F3F0EA"
                android:textSize="9sp"
                android:fontFamily="sans-serif"
                android:singleLine="true" />
            <TextView
                android:id="@+id/widget_carburante_real"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/widget_chip"
                android:paddingLeft="3dp"
                android:paddingRight="3dp"
                android:paddingTop="1dp"
                android:paddingBottom="1dp"
                android:layout_marginTop="2dp"
                android:textColor="#F3F0EA"
                android:textSize="9sp"
                android:fontFamily="sans-serif"
                android:singleLine="true" />
        </LinearLayout>
    </FrameLayout>
    <FrameLayout
        android:id="@+id/widget_altro_cell"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:layout_margin="2.25dp">
        <ImageView
            android:id="@+id/widget_altro_bg"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="fitXY" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="4dp">
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/widget_chip"
                android:paddingLeft="4dp"
                android:paddingRight="4dp"
                android:paddingTop="2dp"
                android:paddingBottom="2dp">
                <TextView
                android:id="@+id/widget_altro_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ALTRO"
                android:textColor="#A8A298"
                android:textSize="7.5sp"
                android:fontFamily="sans-serif"
                android:textStyle="bold"
                android:letterSpacing="0"
                android:singleLine="true" />
                <TextView
                android:id="@+id/widget_altro_left"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#F3F0EA"
                android:textSize="15sp"
                android:fontFamily="sans-serif"
                android:textStyle="bold"
                android:singleLine="true" />
            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />
            <TextView
                android:id="@+id/widget_altro_est"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/widget_chip"
                android:paddingLeft="3dp"
                android:paddingRight="3dp"
                android:paddingTop="1dp"
                android:paddingBottom="1dp"
                android:layout_marginTop="2dp"
                android:textColor="#F3F0EA"
                android:textSize="9sp"
                android:fontFamily="sans-serif"
                android:singleLine="true" />
            <TextView
                android:id="@+id/widget_altro_real"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/widget_chip"
                android:paddingLeft="3dp"
                android:paddingRight="3dp"
                android:paddingTop="1dp"
                android:paddingBottom="1dp"
                android:layout_marginTop="2dp"
                android:textColor="#F3F0EA"
                android:textSize="9sp"
                android:fontFamily="sans-serif"
                android:singleLine="true" />
        </LinearLayout>
    </FrameLayout>
</LinearLayout>

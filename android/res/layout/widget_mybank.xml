<?xml version="1.0" encoding="utf-8"?>
<!-- Widget MyBank 5x1, quattro celle di uguale larghezza; in ognuna, a sinistra, una barra verticale che si svuota dall'alto verso il basso:
     il mese (giorni che restano, ultimo aggiornamento delle banche; vuoti a fine di ogni domenica) e Spesa, Svago, Carburante (nome, residuo del
     budget, spesa giornaliera stimata e reale; la barra e il residuo).
     Solo view ammesse nei RemoteViews (vedi test/android.test.js): un solo carattere, sans-serif. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingLeft="6dp"
    android:paddingRight="6dp"
    android:background="@drawable/widget_bg">
    <LinearLayout
        android:id="@+id/widget_month_cell"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingLeft="4dp"
        android:paddingRight="2dp">
        <ImageView
            android:id="@+id/widget_bar"
            android:layout_width="14.06dp"
            android:layout_height="match_parent"
            android:layout_marginTop="7dp"
            android:layout_marginBottom="7dp"
            android:layout_marginRight="5dp"
            android:scaleType="fitXY" />
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_vertical">
            <TextView
                android:id="@+id/widget_days"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#F3F0EA"
                android:textSize="9.5sp"
                android:fontFamily="sans-serif"
                android:textStyle="bold"
                android:maxLines="2" />
            <TextView
                android:id="@+id/widget_updated"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#A8A298"
                android:textSize="9.5sp"
                android:fontFamily="sans-serif"
                android:layout_marginTop="5dp"
                android:maxLines="2" />
        </LinearLayout>
    </LinearLayout>
    <LinearLayout
        android:layout_width="1dp"
        android:layout_height="match_parent"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="6dp"
        android:background="#3A3733" />
    <LinearLayout
        android:id="@+id/widget_spesa_cell"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingLeft="4dp"
        android:paddingRight="2dp">
        <ImageView
            android:id="@+id/widget_spesa_bar"
            android:layout_width="14.06dp"
            android:layout_height="match_parent"
            android:layout_marginTop="7dp"
            android:layout_marginBottom="7dp"
            android:layout_marginRight="5dp"
            android:scaleType="fitXY" />
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_vertical">
            <TextView
                android:id="@+id/widget_spesa_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="SPESA"
                android:textColor="#A8A298"
                android:textSize="9.5sp"
                android:fontFamily="sans-serif"
                android:textStyle="bold"
                android:letterSpacing="0.06"
                android:singleLine="true" />
            <TextView
                android:id="@+id/widget_spesa_left"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#F3F0EA"
                android:textSize="15sp"
                android:fontFamily="sans-serif"
                android:textStyle="bold"
                android:singleLine="true" />
            <TextView
                android:id="@+id/widget_spesa_est"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#A8A298"
                android:textSize="9.5sp"
                android:fontFamily="sans-serif"
                android:layout_marginTop="3dp"
                android:singleLine="true" />
            <TextView
                android:id="@+id/widget_spesa_real"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#F3F0EA"
                android:textSize="9.5sp"
                android:fontFamily="sans-serif"
                android:singleLine="true" />
        </LinearLayout>
    </LinearLayout>
    <LinearLayout
        android:layout_width="1dp"
        android:layout_height="match_parent"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="6dp"
        android:background="#3A3733" />
    <LinearLayout
        android:id="@+id/widget_svago_cell"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingLeft="4dp"
        android:paddingRight="2dp">
        <ImageView
            android:id="@+id/widget_svago_bar"
            android:layout_width="14.06dp"
            android:layout_height="match_parent"
            android:layout_marginTop="7dp"
            android:layout_marginBottom="7dp"
            android:layout_marginRight="5dp"
            android:scaleType="fitXY" />
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_vertical">
            <TextView
                android:id="@+id/widget_svago_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="SVAGO"
                android:textColor="#A8A298"
                android:textSize="9.5sp"
                android:fontFamily="sans-serif"
                android:textStyle="bold"
                android:letterSpacing="0.06"
                android:singleLine="true" />
            <TextView
                android:id="@+id/widget_svago_left"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#F3F0EA"
                android:textSize="15sp"
                android:fontFamily="sans-serif"
                android:textStyle="bold"
                android:singleLine="true" />
            <TextView
                android:id="@+id/widget_svago_est"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#A8A298"
                android:textSize="9.5sp"
                android:fontFamily="sans-serif"
                android:layout_marginTop="3dp"
                android:singleLine="true" />
            <TextView
                android:id="@+id/widget_svago_real"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#F3F0EA"
                android:textSize="9.5sp"
                android:fontFamily="sans-serif"
                android:singleLine="true" />
        </LinearLayout>
    </LinearLayout>
    <LinearLayout
        android:layout_width="1dp"
        android:layout_height="match_parent"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="6dp"
        android:background="#3A3733" />
    <LinearLayout
        android:id="@+id/widget_carburante_cell"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingLeft="4dp"
        android:paddingRight="2dp">
        <ImageView
            android:id="@+id/widget_carburante_bar"
            android:layout_width="14.06dp"
            android:layout_height="match_parent"
            android:layout_marginTop="7dp"
            android:layout_marginBottom="7dp"
            android:layout_marginRight="5dp"
            android:scaleType="fitXY" />
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_vertical">
            <TextView
                android:id="@+id/widget_carburante_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="CARBURANTE"
                android:textColor="#A8A298"
                android:textSize="9.5sp"
                android:fontFamily="sans-serif"
                android:textStyle="bold"
                android:letterSpacing="0.06"
                android:singleLine="true" />
            <TextView
                android:id="@+id/widget_carburante_left"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#F3F0EA"
                android:textSize="15sp"
                android:fontFamily="sans-serif"
                android:textStyle="bold"
                android:singleLine="true" />
            <TextView
                android:id="@+id/widget_carburante_est"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#A8A298"
                android:textSize="9.5sp"
                android:fontFamily="sans-serif"
                android:layout_marginTop="3dp"
                android:singleLine="true" />
            <TextView
                android:id="@+id/widget_carburante_real"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#F3F0EA"
                android:textSize="9.5sp"
                android:fontFamily="sans-serif"
                android:singleLine="true" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>

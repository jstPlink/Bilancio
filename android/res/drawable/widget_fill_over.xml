<?xml version="1.0" encoding="utf-8"?>
<!-- Riquadro come contenitore (budget superato): sfondo chiaro con angoli da 14dp, come «Da pagare», e liquido che sale dal basso secondo il livello (0-10000) -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#2EFFFFFF" />
            <corners android:radius="14dp" />
        </shape>
    </item>
    <item>
        <clip android:clipOrientation="vertical" android:gravity="bottom">
            <shape android:shape="rectangle">
                <solid android:color="#CCE5484D" />
                <corners android:radius="14dp" />
            </shape>
        </clip>
    </item>
</layer-list>
